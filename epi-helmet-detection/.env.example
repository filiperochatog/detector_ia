# Contents of the file: /epi-helmet-detection/epi-helmet-detection/.env.example

# This is an example of environment variables for the EPI Helmet Detection project.

# Camera settings
CAMERA_INDEX=0  # Index of the camera to use (0 for the default camera)

# Detection settings
CONFIDENCE_THRESHOLD=0.5  # Minimum confidence threshold for detection

# Logging settings
LOG_LEVEL=INFO  # Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)

# Model paths
HELMET_MODEL_PATH=models/helmet_model.h5  # Path to the helmet detection model
PERSON_MODEL_PATH=models/person_model.h5  # Path to the person detection model

# Other configurations
OUTPUT_DIR=data/processed/  # Directory to save processed output
